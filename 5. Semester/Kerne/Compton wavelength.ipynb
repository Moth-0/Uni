   "id": "8852f707",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Si: 6.9807e-16 m\n",
      "Nu: 0.0035361 MeV\n"
     ]
    }
   ],
   "source": [
    "import numpy as np\n",
    "m = 1776.86 # Mass in MeV\n",
    "\n",
    "h = 1.055*10**(-34) # J s\n",
    "c = 2.998*10**8 # m s^-1\n",
    "\n",
    "eV_to_J = 1.60218*10**(-19) # Conversion factor\n",
    "\n",
    "print(f'Si: {2*np.pi * h /(m*10**6*eV_to_J / c):.5g} m')\n",
    "print(f'Nu: {2*np.pi /(m):.5g} MeV')"
   ]
  }
 ],
