@add_power
class MyInt:
    def __init__(self, value):
        self.value = value

    def __str__(self):
        return f'MyInt({self.value})'

    def __mul__(self, other):
    	return MyInt(self.value * other.value)

x = MyInt(6)
y = MyInt(7)

print(f'x = {x}')
print(f'y = {y}')
print(f'x * y = {x * y}')
for power in range(1, 6):
    print(f'x ** {power} = {x ** power}')

